{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(conda env list)",
      "Bash(conda run -n vqcc:*)",
      "Bash(conda run --no-capture-output -n vqcc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Edit(/verifiers/**)",
      "Edit(/sample_submission/**)",
      "Edit(/kickmix/**)",
      "Edit(/submission/2026-10-29/**)",
      "Read(/.env)",
      "Read(/.env.*)",
      "Read(~/.kaggle/**)",
      "Read(//mnt/data2/vqcc/runtime/transport-env.json)"
    ],
    "additionalDirectories": ["/mnt/data2/vqcc"]
  }
}
